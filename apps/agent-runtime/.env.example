# Point Vessel at any OpenAI-compatible endpoint ("Custom Provider").
# Copy this file to .env and fill in your own values. Bun loads .env automatically.
VESSEL_BASE_URL=http://127.0.0.1:3425/v1
VESSEL_API_KEY=magpie

# Which listed model to start with (default: the first one the endpoint reports).
VESSEL_MODEL=qingtian/dbtrt8tvcln3cqaun05g

# Reasoning budget: off | low | medium | high | xhigh. Gateways differ; a model that
# streams reasoning and then stops needs a cheaper level or `off`.
VESSEL_THINKING=xhigh
