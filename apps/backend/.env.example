# Address vesseld listens on.
VESSEL_LISTEN=:8080

# Postgres connection string. Matches the root docker compose service.
DATABASE_URL=postgres://vessel:vessel@localhost:5432/vessel?sslmode=disable

# Static bearer token for /v1. Generate one with: openssl rand -hex 32
VESSEL_API_TOKEN=replace-me-with-a-long-random-token

# Run embedded goose migrations on startup (1) or not (0).
VESSEL_AUTO_MIGRATE=1

# Exact-match CORS allowlist. "null" covers MyGo file/http origins in dev.
VESSEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# debug | info | warn | error
VESSEL_LOG_LEVEL=info

# DANGER: allow unauthenticated API access. Local development only.
VESSEL_ALLOW_INSECURE=0
