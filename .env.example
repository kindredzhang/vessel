# Copy to .env — `docker compose` and the backend both read this file.
# Everything here is a development default; change the token and password.

# --- Postgres (docker compose) ---
POSTGRES_USER=vessel
POSTGRES_PASSWORD=vessel
POSTGRES_DB=vessel
POSTGRES_PORT=5432

# --- Backend ---
# Use your own database by pointing this elsewhere (Neon, RDS, a local server).
DATABASE_URL=postgres://vessel:vessel@localhost:5432/vessel?sslmode=disable
VESSEL_LISTEN=:8080
# Single-user mode: this bearer token is the only credential.
VESSEL_API_TOKEN=dev-token-change-me
# Origins allowed to call the API. `null` covers a MyGo webview's opaque origin.
VESSEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
VESSEL_AUTO_MIGRATE=1
VESSEL_LOG_LEVEL=info

# --- Desktop (MyGo) ---
# Where the window looks for the backend; defaults to http://localhost:8080.
VESSEL_API_URL=http://localhost:8080

# Optional: module proxy for the backend Docker build.
# GOPROXY=https://proxy.golang.org,direct
